<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="14dp"
    android:paddingEnd="0dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/status_badge"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/notification_status_work">

            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification_work" />
        </FrameLayout>

        <Chronometer
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFF8FA"
            android:textSize="36sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/break_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_button_break"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/break_action_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification_break" />

            <TextView
                android:id="@+id/break_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:includeFontPadding="false"
                android:text="@string/notification_break"
                android:textColor="#FFF8FA"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/punch_out_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_button_punch_out"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification_stop" />

            <TextView
                android:id="@+id/punch_out_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:includeFontPadding="false"
                android:text="@string/notification_punch_out"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
